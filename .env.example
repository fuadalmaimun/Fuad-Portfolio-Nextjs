# ---------------------------------------------------------------------------
# EmailJS — powers the Contact form (app/api/contact/route.js)
# ---------------------------------------------------------------------------
# Setup:
#   1. Create a free account at https://dashboard.emailjs.com
#   2. Add an Email Service (Gmail, Outlook, ...) and copy its Service ID.
#   3. Create a Template whose content includes these variables:
#        {{from_name}}  {{from_email}}  {{reply_to}}  {{subject}}  {{message}}
#      and copy the Template ID.
#   4. Copy your Public Key from Account > API Keys.
#
# These are SERVER-ONLY variables (no NEXT_PUBLIC_ prefix) — they are read by
# the API route and are never exposed to the browser.
#
# Until they are set, the contact form gracefully falls back to opening the
# visitor's mail app with the message pre-filled, so the form always works.
# ---------------------------------------------------------------------------

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
